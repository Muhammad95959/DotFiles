{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@mohak34/opencode-notifier@latest"],
  "mcp": {
    "servers": {
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "oauth": false,
        "headers": {
          "X-Goog-Api-Key": "{file:~/.config/opencode/api_keys/stitch}",
        },
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "photocraft": {
        "type": "local",
        "command": [
          "/usr/bin/photocraft-cli",
          "mcp",
          "--automation-read-root",
          "/home/muhammad/Downloads/photocraft",
          "--automation-write-root",
          "/home/muhammad/Downloads/photocraft"
        ]
      },
    },
  },
  "providers": {
    "nvidia": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/nvidia_nim}",
      },
    },
    "cerebras": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/cerebras}",
      },
    },
    "google": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/google_ai_studio}",
      },
    },
    "mistral": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/mistral}",
      },
    },
    "cloudflare-workers-ai": {
      "settings": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/{file:~/.config/opencode/api_keys/cloudflare_account_id}/ai/v1",
        "apiKey": "{file:~/.config/opencode/api_keys/cloudflare_workers_ai}",
      },
    },
    "openrouter": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/openrouter}",
      },
    },
    "sambanova": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.sambanova.ai/v1",
        "apiKey": "{file:~/.config/opencode/api_keys/sambanova}",
      },
      "models": {
        "minimax-m2.7": {},
        "minimax-m3": {},
        "deepseek-v3.1": {},
        "deepseek-v3.2": {},
        "gpt-oss-120b": {},
        "gemma-4-31b": {},
        "llama-3.3-70b": {},
      },
    },
    "zai": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/zai}",
      },
    },
    "kilo": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/kilo}",
      },
    },
    "llm7": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.llm7.io/v1",
        "apiKey": "{file:~/.config/opencode/api_keys/llm7}",
      },
      "models": {
        "minimax-m2.7": {},
        "gpt-oss:20b": {},
        "codestral-latest": {},
        "gemini-3.1-flash-lite": {},
        "mistral-Nemo-Instruct-2407": {},
      },
    },
    "requesty": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/requesty}",
      },
    },
    "ollama-cloud": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/api_keys/ollama_cloud}",
      },
    },
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow",
    },
  ],
  "experimental": {
    "todo": true,
  },
}
