{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@mohak34/opencode-notifier@latest",
    "github:itsyasirkhandev/opencode-cline-free"
  ],
  "mcp": {
    "servers": {
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "oauth": false,
        "headers": {
          "X-Goog-Api-Key": "{file:~/.config/opencode/api_keys/stitch}",
        },
      },
      "photocraft": {
        "type": "local",
        "command": [
          "/usr/bin/photocraft-cli",
          "mcp",
          "--automation-read-root",
          "/home/muhammad/Pictures",
          "--automation-write-root",
          "/home/muhammad/Pictures"
        ]
      },
    },
  },
  "experimental": {
    "todo": true,
  },
}
