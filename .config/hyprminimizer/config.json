{
  "specialWorkspace": "minimized",
  "restoreLauncher": "rofi",
  "restoreLauncherArgs": "-theme ~/.config/rofi/arc_rounded.rasi -dmenu -p \"Restore window:\"",
  "maxMinimizedWindows": 50,
  "excludeWindowClasses": [
    "waybar",
    "mako",
    "hyprlock"
  ],
  "useDBusTray": true,
  "dbusServiceName": "org.hyprminimizer",
  "stackBaseDirectory": "/tmp",
  "restoreToCurrentWorkspace": true,
  "iconPack": {
    "kitty": "terminal",
    "brave-translate.google.com.eg__-Default": "google-translate",
    "chrome-translate.google.com.eg__-Default": "google-translate",
    "chrome-web.whatsapp.com__-Default": "whatsapp",
    "Waydroid": "waydroid"
  }
}
