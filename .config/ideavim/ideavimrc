""" Map leader to space ---------------------
let mapleader=" "

""" Plugins  --------------------------------
set NERDTree
set which-key
set surround
set multiple-cursors
set commentary
set argtextobj
set exchange
set highlightedyank
set vim-paragraph-motion
set textobj-indent

""" Plugin settings -------------------------
let g:highlightedyank_highlight_duration = 200

""" Common settings -------------------------
set number
set relativenumber
set autoindent
set tabstop=4
set shiftwidth=4
set smarttab
set softtabstop=4
set ignorecase
set smartcase
set scrolloff=5
set mouse=a
set incsearch
set notimeout
set noerrorbells
set clipboard=unnamedplus
set clipboard+=ideaput
set virtualedit=block

""" Idea specific settings ------------------
set ideajoin
set visualbell
set noerrorbells
set ideastatusicon=gray
set idearefactormode=keep

""" Mappings --------------------------------
nnoremap <A-j> <ESC>:m .+1<CR>
nnoremap <A-k> <ESC>:m .-2<CR>

vnoremap < <gv
vnoremap > >gv

vnoremap <A-j> :m .+1<CR>==gv
vnoremap <A-k> :m .-2<CR>==gv

" clipboard / black-hole (from LazyVim lua/config/keymaps.lua)
" x/s/r/c/C/X/S/R -> black hole, <A-d> -> black hole
noremap x "_x
noremap X "_X
noremap s "_s
noremap S "_S
noremap r "_r
noremap R "_R
noremap c "_c
noremap C "_C
noremap <A-d> "_d
noremap <A-D> "_D

" visual paste swap p<->P (LazyVim keymaps.lua:8)
xnoremap p P
xnoremap P p

" keep visual selection yank/paste with Ctrl (LazyVim keymaps.lua:21)
vnoremap <C-c> y
vnoremap <C-v> p

" save/close buffer (LazyVim ZZ/ZQ -> Save_and_close_buffer / Close_buffer)
nnoremap ZZ :w<CR><Action>(CloseContent)<CR>
nnoremap ZQ <Action>(CloseContent)<CR>

nmap <C-n> <Plug>NextWholeOccurrence
xmap <C-n> <Plug>NextWholeOccurrence
nmap g<C-n> <Plug>NextOccurrence
xmap g<C-n> <Plug>NextOccurrence
nmap <C-x> <Plug>SkipOccurrence
xmap <C-x> <Plug>SkipOccurrence
nmap <C-p> <Plug>RemoveOccurrence
xmap <C-p> <Plug>RemoveOccurrence

map <S-Space> <Action>(GotoNextError)
map <leader>/ <Action>(ShowErrorDescription)
map <leader>b <Action>(ToggleLineBreakpoint)
map <leader>c <Action>(Stop)
map <leader>d <Action>(Debug)
map <leader>n <Action>(RenameElement)
map <leader>r <Action>(Run)
map <leader>s :source ~/.ideavimrc<CR>
map <leader>w <Action>(EditorToggleUseSoftWraps)
map <A-l> :action NextTab<CR>
map <A-h> :action PreviousTab<CR>
map <A-,> <Action>(MoveTabLeft)<CR>
map <A-.> <Action>(MoveTabRight)<CR>
map <leader>cs <Action>(Stop)<CR>
